# BukhariAI Deployment Environment Variables

# Database SA Password (for SQL Server container)
MSSQL_SA_PASSWORD=YourStrong@Password_2026!

# JWT Secret Key (MUST be at least 32 characters long)
JWT_SECRET_KEY=ReplaceWithRandomKeyAtLeast32CharactersLongSecure!

# AI Provider Configuration
AI_PROVIDER=Gemini
AI_MODEL=gemini-3.6-flash
AI_API_KEY=your_gemini_api_key_here

# Fallback AI Configuration (optional)
AI_FALLBACK_API_KEY=your_conduit_or_claude_api_key
