{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "BukhariAI": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=BukhariAIDb;User Id=sa;Password=YourStrong@Password;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "Jwt": {
    "SecretKey": "REPLACE_WITH_STRONG_RANDOM_SECRET_KEY_MINIMUM_32_CHARS",
    "Issuer": "BukhariAI",
    "Audience": "BukhariAIApp"
  },
  "PdfExtraction": {
    "MaximumPageRange": 20,
    "RenderWidth": 1800,
    "RenderHeight": 2400,
    "VisionImageQuality": 85
  },
  "AI": {
    "Provider": "Gemini",
    "Model": "gemini-3.7-flash",
    "ApiKey": "",
    "FallbackApiKey": "",
    "FallbackEndpoint": "https://conduit.ozdoev.net/v1/chat/completions",
    "FallbackModel": "claude-sonnet-4-5"
  },
  "EnableSwagger": false,
  "DisableHttpsRedirection": false
}
