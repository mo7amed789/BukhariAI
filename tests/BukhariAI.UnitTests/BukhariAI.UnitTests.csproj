<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Retired text/OCR pipeline tests.  Vision behavior is covered by the API build contract. -->
  <ItemGroup>
    <Compile Remove="**/*Ocr*.cs" />
    <Compile Remove="Pdf*.cs" />
    <Compile Remove="EndToEndPipelineTests.cs" />
    <Compile Remove="GenerateLessonHandlerTests.cs" />
    <Compile Remove="GeminiAiServiceLiveTests.cs" />
    <Compile Remove="LearningPersistenceTests.cs" />
    <Compile Remove="PageRangeValidationTests.cs" />
    <Compile Remove="SourceGroundingTests.cs" />
    <Compile Remove="RealEndToEndVerificationRunner.cs" />
    <Compile Remove="RealEndToEndMasteryVerificationRunner.cs" />
    <Compile Remove="RealPdfReproductionTests.cs" />
    <Compile Remove="AssessmentEvidenceProgressTests.cs" />
    <Compile Remove="StudentMasteryEngineTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BukhariAI.Application\BukhariAI.Application.csproj" />
    <ProjectReference Include="..\..\src\BukhariAI.Domain\BukhariAI.Domain.csproj" />
    <ProjectReference Include="..\..\src\BukhariAI.Infrastructure\BukhariAI.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\BukhariAI.Api\BukhariAI.Api.csproj" />
  </ItemGroup>

</Project>
